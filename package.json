{
    "name": "codex-whip",
    "version": "0.1.0",
    "description": "Pick up where Codex left off. A lightweight quota-recovery CLI.",
    "type": "module",
    "license": "MIT",
    "author": "Carl Lapierre",
    "engines": {
        "node": ">=22.18.0"
    },
    "bin": {
        "codex-whip": "bin/codex-whip.mjs"
    },
    "files": [
        "bin",
        "dist",
        "migrations",
        "README.md",
        "LICENSE",
        "NOTICE.md",
        "docs/*.md"
    ],
    "scripts": {
        "dev": "npm run build && npm start --",
        "build": "tsc -p tsconfig.build.json",
        "start": "node bin/codex-whip.mjs",
        "typecheck": "tsc --noEmit",
        "test": "node scripts/test.mjs",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
        "prepack": "npm run build"
    },
    "keywords": [
        "codex",
        "cli",
        "quota",
        "auto-resume",
        "local-first"
    ],
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/node": "^22.18.0",
        "eslint": "^9.35.0",
        "prettier": "^3.6.0",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.40.0"
    }
}
